# Cloudflare Configuration

# Account ID
# Found in Dashboard > Workers & Pages > Overview (Right side)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token
# Found in Dashboard > My Profile > API Tokens
# REQUIRED PERMISSIONS:
# - Account.Workers AI: Read/Run (for Embeddings & LLM Generation)
# - Account.Vectorize: Edit (Read/Write for Vector Search & Upsert)
# - Account.D1: Edit (Read/Write for Database)
# - Account.Workers R2 Storage: Edit (Read/Write for Policy Content)
CLOUDFLARE_API_TOKEN=

# Resource IDs
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_VECTORIZE_INDEX_NAME=sgd-hbd-policy
R2_BUCKET_NAME=sgd-hbd-data

# Application Config
LOG_LEVEL=INFO

# Optional Secrets
GOOGLE_MAPS_API_KEY=
